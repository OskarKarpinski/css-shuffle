{
  "name": "css-shuffle",
  "version": "1.3.0",
  "description": "Tool for obfuscating and randomizing all CSS classes and ID names in your HTML, CSS files.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    }
  },
  "type": "module",
  "keywords": [
    "css",
    "css-shuffle",
    "css-obfuscator",
    "css-mangler",
    "obfuscator",
    "obfuscation",
    "classnames",
    "classes",
    "minifier",
    "minify",
    "astro",
    "astro-integration",
    "withastro",
    "vite",
    "vite-plugin"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarKarpinski/css-shuffle.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Oskar Karpiński",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OskarKarpinski/css-shuffle/issues"
  },
  "homepage": "https://github.com/OskarKarpinski/css-shuffle#readme",
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "cheerio": "^1.2.0",
    "console-table-printer": "^2.16.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "pretty-bytes": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "astro": "^7.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
