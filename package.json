{
  "name": "css-shuffle",
  "version": "1.2.1",
  "description": "Tool for obfuscating and randomizing all CSS classes and ID names in your HTML, CSS files.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    }
  },
  "type": "module",
  "keywords": [
    "css",
    "css-shuffle",
    "css-obfuscator",
    "css-mangler",
    "obfuscator",
    "obfuscation",
    "classnames",
    "classes",
    "minifier",
    "minify",
    "astro",
    "astro-integration",
    "withastro",
    "vite",
    "vite-plugin"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarKarpinski/css-shuffle.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Oskar Karpiński",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OskarKarpinski/css-shuffle/issues"
  },
  "homepage": "https://github.com/OskarKarpinski/css-shuffle#readme",
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "cheerio": "^1.1.2",
    "console-table-printer": "^2.14.6",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0",
    "pretty-bytes": "^7.0.1"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.3.0",
    "astro": "^5.13.3",
    "typescript": "^5.9.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "astro": ">=4.0.0 || >=5.0.0",
    "vite": ">=5.0.0 || >=6.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
