---
const renderTime = new Date().toISOString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro SSR + CSS Shuffle</title>
    <style>
      .ssr-wrapper {
        max-width: 600px;
        margin: 3rem auto;
        font-family: system-ui, sans-serif;
      }
      .badge {
        display: inline-block;
        background: #e0e7ff;
        color: #3730a3;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.875rem;
      }
      .server-status {
        color: #047857;
      }
    </style>
  </head>
  <body>
    <main class="ssr-wrapper">
      <h1>Server-Side Rendered Page</h1>
      <p class="badge">SSR Mode</p>
      <p>Rendered at: <code>{renderTime}</code></p>
      <p class="server-status">This class is safelisted!</p>
    </main>
  </body>
</html>
